# Local dev reads .env.local. A real production build additionally reads
# .env.production.local (gitignored, not present in this template) for any
# key that needs a different value in production - see that file's own
# header comment for why.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Paddle client-side token for Paddle.js checkout. Sandbox tokens are
# prefixed test_, live tokens are prefixed live_.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Must be exactly "sandbox" or "production" - getPaddleInstance() fails fast
# on anything else rather than silently defaulting.
NEXT_PUBLIC_PADDLE_ENV=

# Paddle server-side secret API key used to construct the Node SDK instance
# the webhook route verifies signatures with. Never expose to the browser.
PADDLE_API_KEY=

# Signing secret from the notification destination matching the current
# NEXT_PUBLIC_PADDLE_ENV - verifies the Paddle-Signature header on incoming
# webhooks. Sandbox and live destinations each have their own secret.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Global kill switch for the Settings > Subscription tab / checkout flow.
# Off (unset, or anything other than the literal string "true") by default.
# NEXT_PUBLIC_* vars are baked in at build time - check this against what
# should actually ship before every production build, not just local dev.
NEXT_PUBLIC_SUBSCRIPTION_TAB_ENABLED=
